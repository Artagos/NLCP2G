# Copy to .env or export these before running the backend.
# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Optional model overrides (both have free tiers):
# CP_TUTOR_ROUTER_MODEL=gemini-2.5-flash-lite
# CP_TUTOR_MAIN_MODEL=gemini-2.5-flash

# Optional: override the sandbox image name (default: cp-tutor-sandbox)
# CP_TUTOR_SANDBOX_IMAGE=cp-tutor-sandbox

# ---- HW3: the chat channel ----
# A DISPOSABLE identity. Create a bot with @BotFather on Telegram, copy the token
# here. Never a personal account, and never commit this file (.env is gitignored;
# .env.example is tracked, so keep placeholders only).
TELEGRAM_BOT_TOKEN=paste-your-botfather-token-here

# Chat ids allowed to reach the privileged operator agent. Empty means NOBODY is
# an admin, which is the safe default. Message the bot and check the log to find
# your own chat id.
CP_TUTOR_ADMIN_CHAT_IDS=

# Shared secret between the sandbox worker and the run-complete webhook. Anyone
# who can reach the webhook without this cannot post a fake verdict.
CP_TUTOR_WEBHOOK_SECRET=change-me
CP_TUTOR_WEBHOOK_URL=http://127.0.0.1:8000/hooks/run-complete

# Background trigger pacing (seconds / local hours). Optional.
# CP_TUTOR_ACTIVE_WINDOW_S=5400
# CP_TUTOR_NUDGE_COOLDOWN_S=72000
# CP_TUTOR_QUIET_FROM=22
# CP_TUTOR_QUIET_UNTIL=8
