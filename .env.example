# Copy to .env or export these before running the backend.
# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Optional model overrides (both have free tiers):
# CP_TUTOR_ROUTER_MODEL=gemini-2.5-flash-lite
# CP_TUTOR_MAIN_MODEL=gemini-2.5-flash

# Optional: override the sandbox image name (default: cp-tutor-sandbox)
# CP_TUTOR_SANDBOX_IMAGE=cp-tutor-sandbox

# ---- HW3: the chat channel ----
# A DISPOSABLE identity. Create a bot with @BotFather on Telegram, copy the token
# here. Never a personal account, and never commit this file (.env is gitignored;
# .env.example is tracked, so keep placeholders only).
TELEGRAM_BOT_TOKEN=paste-your-botfather-token-here

# Chat ids allowed to reach the privileged operator agent. Empty means NOBODY is
# an admin, which is the safe default. Message the bot and check the log to find
# your own chat id.
CP_TUTOR_ADMIN_CHAT_IDS=

# Shared secret between the sandbox worker and the run-complete webhook. Anyone
# who can reach the webhook without this cannot post a fake verdict.
CP_TUTOR_WEBHOOK_SECRET=change-me
CP_TUTOR_WEBHOOK_URL=http://127.0.0.1:8000/hooks/run-complete

# Background trigger pacing (seconds / local hours). Optional.
# CP_TUTOR_ACTIVE_WINDOW_S=5400
# CP_TUTOR_NUDGE_COOLDOWN_S=72000
# CP_TUTOR_QUIET_FROM=22
# CP_TUTOR_QUIET_UNTIL=8

# ---- HW6: local tracing ----
# Off unless this is exactly "1". Nothing is recorded otherwise, and the app
# runs identically with mlflow not installed at all — it lives in
# requirements-eval.txt, deliberately not in the runtime image.
#
# Traces go to a SQLite file on THIS machine and are never sent anywhere. That
# is the whole difference from LangSmith, which backend/llm.py declines to
# enable because it would ship learner messages and generated code off-box.
# Read them with:  mlflow ui --backend-store-uri sqlite:///mlflow.db
# CP_TUTOR_TRACING=1
# CP_TUTOR_TRACING_URI=sqlite:///mlflow.db
# CP_TUTOR_TRACING_EXPERIMENT=nlcp2g

# Sampling temperature. UNSET BY DEFAULT, and that is not an oversight: this
# project has never pinned one, so the tutor runs at the provider default. The
# agent eval sets it explicitly so the number ends up on the record.
# CP_TUTOR_TEMPERATURE=0.7

# ---- evaluation models (optional; every one has a working default) ----
# These were read by the code and documented nowhere until HW6.
# CP_TUTOR_JUDGE_MODEL=gemini-2.5-flash-lite   # the LLM-as-judge
# CP_TUTOR_EVAL_GENERATOR=gemini-2.5-flash     # answers the retrieval eval set
# CP_TUTOR_RERANK_MODEL=gemini-2.5-flash       # reranks the fused candidates
# CP_TUTOR_EMBED_MODEL=models/gemini-embedding-001
# CP_TUTOR_EMBED_DIMS=768
